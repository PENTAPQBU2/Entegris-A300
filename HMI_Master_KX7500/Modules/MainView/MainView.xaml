<UserControl x:Class="HMI_Master_KX7500.Modules.MainView.MainView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:HMI_Master_KX7500.Modules.MainView">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30*"/>
            <ColumnDefinition Width="70*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <StackPanel>
                <StackPanel.Resources>
                </StackPanel.Resources>
                <GroupBox>
                    <UniformGrid Columns="2">
                        <TextBlock Text="Machine Name:" />
                        <TextBlock x:Name="MachineNameTextBlock" />
                        <TextBlock Text="Project No:" />
                        <TextBlock x:Name="ProjectNoTextBlock" />
                    </UniformGrid>
                </GroupBox>

                <GroupBox>
                    <UniformGrid Columns="2">
                        <TextBlock Text="Software/program ver:" />
                        <TextBlock x:Name="SoftwareProgramVerTextBlock" />
                    </UniformGrid>
                </GroupBox>

                <!--<GroupBox>
                <UniformGrid Columns="2">
                    <TextBlock Text="Bypass Status:" />
                    <TextBlock x:Name="BypassStatusTextBlock" />
                </UniformGrid>
            </GroupBox>-->

                <GroupBox>
                    <UniformGrid Columns="2">
                        <TextBlock Text="Total Pass:" />
                        <TextBlock x:Name="TotalPassTextBlock" />
                        <TextBlock Text="Total Fail:" />
                        <TextBlock x:Name="TotalFailTextBlock" />
                        <TextBlock Text="Lot Qty:" />
                        <TextBlock x:Name="LotQtyTextBlock" />
                        <TextBlock Text="Current Foup:" />
                        <TextBlock x:Name="CurrentFoupTextBlock" />
                        <TextBlock Text="Loaded Shell:" />
                        <TextBlock x:Name="LoadedShellTextBlock" />
                        <TextBlock Text="Loaded Side Column:" />
                        <TextBlock x:Name="LoadedSideColumnTextBlock" />
                        <TextBlock Text="Loaded Shim and Oring:" />
                        <TextBlock x:Name="LoadedShimOringTextBlock" />
                    </UniformGrid>
                </GroupBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <GroupBox   Header="{DynamicResource MachineLayout}" >
                <DockPanel DataContext="{Binding MachineLayoutInterfaceModel.MachineLayoutModel}">

                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Height="500">
                        <GroupBox Header="Legend" HorizontalAlignment="Left">
                            <ItemsControl IsHitTestVisible="False" ItemsSource="{Binding MachineLayoutModuleStatusListView}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource IndicatorButtonBase}"
                                    Height="25"
                                    BorderBrush="{Binding MachineLayoutModuleStatusColor}"
                                    Content="{Binding MachineLayoutModuleStatusName}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding MachineLayoutModuleListView}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal"/>
                                <!--<UniformGrid Columns="2" Rows="1" Height="650" ></UniformGrid>-->
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock  Style="{StaticResource CenterTextBlock}" FontSize="20" FontWeight="Bold"
                                           Text="{Binding MachineLayoutModuleName}" DockPanel.Dock="Top"/>

                                    <WrapPanel  HorizontalAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Bottom" >
                                        <Image Width="800" UseLayoutRounding="True" Stretch="Fill" Source="{Binding MachineLayoutModuleImage}"/>

                                        <ItemsControl ItemsSource="{Binding MachineLayoutModuleStatusIndicatorListView}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Canvas>
                                                        <Line  StrokeThickness="2"
                                                          X1="{Binding MachineLayoutModuleStatusIndicatorLine1X1}"
                                                          X2="{Binding MachineLayoutModuleStatusIndicatorLine1X2}"
                                                          Y1="{Binding MachineLayoutModuleStatusIndicatorLine1Y1}"
                                                          Y2="{Binding MachineLayoutModuleStatusIndicatorLine1Y2}"/>

                                                        <Line  StrokeThickness="2"
                                                          X1="{Binding MachineLayoutModuleStatusIndicatorLine2X1}"
                                                          X2="{Binding MachineLayoutModuleStatusIndicatorLine2X2}"
                                                          Y1="{Binding MachineLayoutModuleStatusIndicatorLine2Y1}"
                                                          Y2="{Binding MachineLayoutModuleStatusIndicatorLine2Y2}"/>

                                                        <Button Style="{StaticResource IndicatorButtonBase}"
                                                            Height="25"
                                                            Canvas.Right="{Binding MachineLayoutModuleStatusIndicatorRightPosition}"
                                                            Canvas.Top="{Binding MachineLayoutModuleStatusIndicatorTopPosition}"
                                                            BorderBrush="{Binding MachineLayoutModuleStatusIndicatorColor}"
                                                            Content="{Binding MachineLayoutModuleStatusIndicatorName}"/>
                                                    </Canvas>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </WrapPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </GroupBox>
        </Grid>
       
    </Grid>
</UserControl>