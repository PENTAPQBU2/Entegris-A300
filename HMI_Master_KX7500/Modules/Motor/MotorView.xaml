                                                <TextBlock Grid.Column="1" Text="{Binding AxisHomingActionName}"
                                                           Style="{StaticResource ValueTextBlockStyle}"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </GroupBox>

