                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Style="{StaticResource KeyTextBlockStyle}"
                                                       Text="{Binding AxisMoveAbsoluteNumericName}"/>

                                            <mahApps:NumericUpDown Grid.Column="1" Tag="{Binding}"
                                                                   x:Name="AxisMoveAbsoluteNumericUpDown"
                                                                   HasDecimals="True"
                                                                   Value="{Binding AxisMoveAbsoluteNumeric}"/>

                                            <Button Grid.Column="2"
                                                    Command="{Binding SetAxisMoveAbsoluteNumericCommand}"
                                                    CommandParameter="{Binding ElementName=AxisMoveAbsoluteNumericUpDown}"
                                                    IsEnabled="{Binding ElementName=AxisMoveAbsoluteNumericUpDown, Path=Value, Converter={StaticResource NullToBooleanConverter}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Image Grid.Column="0"
                                                           Width="50" Height="50"
                                                           Source="pack://application:,,,/HMI_SSDC_PIM;component/Icon/Flash.png"/>

                                                    <TextBlock Grid.Column="1" Text="{DynamicResource Set}"
                                                               Style="{StaticResource ValueTextBlockStyle}"/>
                                                </Grid>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl Grid.Row="1" Grid.Column="1"
                                          ItemsSource="{Binding AxisMoveAbsoluteActionListView}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding AxisMoveAbsoluteActionCommand}"
                                                CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Image Grid.Column="0"
                                                       Width="50" Height="50"
                                                       Source="{Binding AxisMoveAbsoluteActionIcon}"/>

                                                <TextBlock Grid.Column="1"
                                                           Style="{StaticResource ValueTextBlockStyle}"
                                                           Text="{Binding AxisMoveAbsoluteActionName}"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </GroupBox>

