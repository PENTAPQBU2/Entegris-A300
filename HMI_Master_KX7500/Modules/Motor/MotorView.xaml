<UserControl x:Class="HMI_Master_KX7500.MotorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HMI_Master_KX7500"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:mahApps="http://metro.mahapps.com/winfx/xaml/controls">
    
    <UserControl.Resources>
        <Style x:Key="ValueTextBlockStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Padding" Value="4 2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.23"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KeyTextBlockStyle" TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource ValueTextBlockStyle}">
            <Setter Property="FontWeight" Value="Black"/>
        </Style>

        <Style x:Key="TitleTextBlockStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ValueTextBlockStyle}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="20"/>
        </Style>
    </UserControl.Resources>


    <GroupBox DataContext="{Binding MotorInterfaceModel}" HorizontalAlignment="Left">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*"/>
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Row="0">
                <Button Grid.Column="2" Command="{Binding ImportMotorAxisTeachingPositionCommand}"
                        Visibility="{Binding AllowImportMotorAxisTeachingPosition, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0"
                               Source="pack://application:,,,/HMI_SSDC_PIM;component/Icon/Import.png"/>

                        <TextBlock Grid.Column="1" Style="{StaticResource ValueTextBlockStyle}"
                                   Text="{DynamicResource ImportMotorAxisTeachingPosition}"/>
                    </Grid>
                </Button>

                <Button Grid.Column="3" Command="{Binding ExportMotorAxisTeachingPositionCommand}"
                        Visibility="{Binding AllowExportMotorAxisTeachingPosition, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0"
                               Source="pack://application:,,,/HMI_SSDC_PIM;component/Icon/Export.png"/>

                        <TextBlock Grid.Column="1" Style="{StaticResource ValueTextBlockStyle}"
                                   Text="{DynamicResource ExportMotorAxisTeachingPosition}"/>
                    </Grid>
                </Button>
            </WrapPanel>

            <GroupBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" DataContext="{Binding MotorModel}">
                <DockPanel>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           FontWeight="Bold" Text="{DynamicResource Axis}" FontSize="20"/>

                    <ComboBox Grid.Column="1" x:Name="AxisComboBox" DisplayMemberPath="AxisName"
                              ItemsSource="{Binding AxisListView}" HorizontalContentAlignment="Center">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding AxisSelectionChangedCommand}"
                                                       CommandParameter="{Binding ElementName=AxisComboBox}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>
                </DockPanel>
            </GroupBox>

            <ScrollViewer Grid.Row="2" Grid.Column="0"
                          DataContext="{Binding ElementName=AxisComboBox, Path=SelectedItem}"
                          Visibility="{Binding ElementName=AxisComboBox, Path=SelectedItem, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="90"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                              DataContext="{Binding AxisGeneralModel}" Header="{DynamicResource General}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ItemsControl Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" IsHitTestVisible="False"
                                          ItemsSource="{Binding AxisGeneralStatusListView}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource IndicatorCheckBox}"
                                                  Content="{Binding AxisGeneralStatusName}"
                                                  IsChecked="{Binding AxisGeneralStatus}">
                                            <CheckBox.LayoutTransform>
                                                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                            </CheckBox.LayoutTransform>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl Grid.Row="0" Grid.Column="1"
                                          ItemsSource="{Binding AxisGeneralNumericListView}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Style="{StaticResource KeyTextBlockStyle}"
                                                       Text="{Binding AxisGeneralNumericName}"/>

                                            <mahApps:NumericUpDown Grid.Column="1" Tag="{Binding}"
                                                                   x:Name="AxisGeneralNumericUpDown"

                                                                   HasDecimals="True"
                                                                   HideUpDownButtons="True"
                                                                   IsReadOnly="True"
                                                                   Value="{Binding AxisGeneralNumeric}"/>

                                            <!--<Button Grid.Column="2" Command="{Binding SetAxisGeneralNumericCommand}"
                                                    CommandParameter="{Binding ElementName=AxisGeneralNumericUpDown}"
                                                    IsEnabled="{Binding ElementName=AxisGeneralNumericUpDown, Path=Value, Converter={StaticResource NullToBooleanConverter}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Image Grid.Column="0"
                                                           Width="50" Height="50"
                                                           Source="pack://application:,,,/HMI;component/Icons/Flash.png"/>

                                                    <TextBlock Grid.Column="1" Text="{DynamicResource Set}"
                                                               Style="{StaticResource ValueTextBlockStyle}"/>
                                                </Grid>
                                            </Button>-->
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl Grid.Row="1" Grid.Column="1"
                                          ItemsSource="{Binding AxisGeneralActionListView}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding AxisGeneralActionCommand}"
                                                CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Image Grid.Column="0" Source="{Binding AxisGeneralActionIcon}"
                                                       Width="50" Height="50"/>

                                                <TextBlock Grid.Column="1" Text="{Binding AxisGeneralActionName}"
                                                           Style="{StaticResource ValueTextBlockStyle}"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </GroupBox>

