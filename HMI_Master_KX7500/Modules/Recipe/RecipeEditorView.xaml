<Window x:Class="HMI_Master_KX7500.Modules.Recipe.RecipeEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HMI_Master_KX7500.Modules.Recipe"
        xmlns:cmd="http://www.galasoft.ch/mvvmlight"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        x:Name="RecipeEditorWindow" Height="800"
        ResizeMode="NoResize" TextElement.FontSize="16"
        TextElement.FontWeight="Regular" TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto" Title="{DynamicResource RecipeEditor}"
        Topmost="True" Width="1000" WindowStartupLocation="CenterScreen">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <cmd:EventToCommand Command="{Binding RecipeEditorViewClosingCommand}"
                                EventArgsConverter="{StaticResource EventArgsConverter}"
                                EventArgsConverterParameter="{Binding ElementName=RecipeEditorWindow}"
                                PassEventArgsToCommand="True"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Row="0" Grid.Column="0" Source="pack://application:,,,/HMI;component/Icons/Papers.png"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource KeyTextBlockStyle}"
                   Text="{DynamicResource Recipe}"/>

        <ComboBox Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="6" x:Name="RecipeComboBox"
                  ItemsSource="{Binding RecipeList}" SelectedIndex="{Binding RecipeComboBoxSelectedIndex}">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="PreviewMouseDown">
                    <i:InvokeCommandAction Command="{Binding RecipeComboBoxPreviewMouseDownCommand}"/>
                </i:EventTrigger>
                <i:EventTrigger EventName="SelectionChanged">
                    <i:InvokeCommandAction Command="{Binding RecipeComboBoxSelectionChangedCommand}"
                                           CommandParameter="{Binding ElementName=RecipeComboBox, Path=SelectedItem}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </ComboBox>

        <Button Grid.Row="1" Grid.Column="2" Command="{Binding AddNewRecipeCommand}"
                CommandParameter="{Binding ElementName=RecipeNameTextBox, Path=Text}" IsEnabled="{Binding NewRecipeButtonEnabled}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="pack://application:,,,/HMI;component/Icons/Document.png"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ValueTextBlockStyle}"
                           Text="{DynamicResource New}"/>
            </Grid>
        </Button>

        <Button Grid.Row="1" Grid.Column="3" Command="{Binding SaveRecipeCommand}"                 
                CommandParameter="{Binding ElementName=RecipeComboBox, Path=SelectedItem}">
            <Button.Style>
                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonBaseStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=RecipeComboBox, Path=SelectedItem}"
                                     Value="{x:Null}">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ElementName=RecipeNameTextBox, Path=Text}" Value="">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ElementName=RecipeNameTextBox, Path=Text}" Value="{x:Null}">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>

            <!--<Button.CommandParameter>
                <MultiBinding Converter="{StaticResource RecipeEditorModelConverter}">
                    <Binding ElementName="RecipeNameTextBox" Path="Text"/>
                    <Binding ElementName="RecipeComboBox" Path="Text"/>
                </MultiBinding>
            </Button.CommandParameter>-->

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="pack://application:,,,/HMI;component/Icons/Diskette.png"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ValueTextBlockStyle}"
                           Text="{DynamicResource Save}"/>
            </Grid>
        </Button>

        <Button Grid.Row="1" Grid.Column="4" Command="{Binding DeleteRecipeCommand}"
                CommandParameter="{Binding ElementName=RecipeComboBox, Path=SelectedItem}"
                HorizontalAlignment="Left" IsEnabled="{Binding ElementName=RecipeComboBox, Path=SelectedItem, Converter={StaticResource NullToBooleanConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="pack://application:,,,/HMI;component/Icons/TrashCan.png"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ValueTextBlockStyle}"
                           Text="{DynamicResource Delete}"/>
            </Grid>
        </Button>

        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource KeyTextBlockStyle}"
                   Text="{DynamicResource RecipeName}"/>
        <TextBox Grid.Row="2" Grid.Column="3" x:Name="RecipeNameTextBox" Text="{Binding RecipeName}" MaxLength="20" IsEnabled="{Binding RecipeNameEditable}">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="KeyDown">
                    <cmd:EventToCommand Command="{Binding KeyDownCommand}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </TextBox>
    </Grid>
</Window>
