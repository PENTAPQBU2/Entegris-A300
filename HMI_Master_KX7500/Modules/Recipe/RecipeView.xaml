<UserControl x:Class="HMI_Master_KX7500.Modules.Recipe.RecipeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HMI_Master_KX7500.Modules.Recipe"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity">
    
    <StackPanel Height="{DynamicResource ButtonHeaderHeight}" >
        
        <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource FlatButtonBaseStyle}"
                        Command="{Binding EditRecipeCommand}" HorizontalAlignment="Right"
                        Visibility="{Binding AllowEditRecipe, Converter={StaticResource BooleanToVisibilityConverter}}" DataContext="{Binding RecipeInterfaceModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="pack://application:,,,/HMI_Master_KX7500;component/Icon/Pencil.png" Width="35"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ValueTextBlockStyle}"
                                   Text="{DynamicResource EditRecipe}"/>
            </Grid>
        </Button>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Image Grid.Row="0" Grid.Column="0" Source="pack://application:,,,/HMI_Master_KX7500;component/Icon/Papers.png"/>

            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource KeyTextBlockStyle}"
                       Text="{DynamicResource Recipe}"/>

            <ComboBox Grid.Row="0" Grid.Column="2" x:Name="RecipeComboBox" ItemsSource="{Binding RecipeList}" >
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseDown">
                        <i:InvokeCommandAction Command="{Binding RecipeComboBoxPreviewMouseDownCommand}"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding RecipeComboBoxSelectionChangedCommand}"
                                           CommandParameter="{Binding ElementName=RecipeComboBox, Path=SelectedItem}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ComboBox>

            <Button Grid.Row="1" Grid.Column="2" Command="{Binding LoadRecipeCommand}"
                    CommandParameter="{Binding ElementName=RecipeComboBox, Path=SelectedItem}"
                    IsEnabled="{Binding LoadRecipeAllowed}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="pack://application:,,,/HMI_Master_KX7500;component/Icon/Download.png" Width="35"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource ValueTextBlockStyle}"
                               Text="{DynamicResource Load}"/>
                </Grid>
            </Button>
        </Grid>
    </StackPanel>
</UserControl>
