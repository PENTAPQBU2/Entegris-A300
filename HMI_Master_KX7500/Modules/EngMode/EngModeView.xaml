<UserControl x:Class="HMI_Master_KX7500.EngModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HMI_Master_KX7500"
             xmlns:mahApps="http://metro.mahapps.com/winfx/xaml/controls">

    <!--<Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>-->
        <ScrollViewer VerticalScrollBarVisibility="Disabled">
            <ItemsControl DataContext="{Binding EngineeringInterfaceModel.EngineeringMainModel}"
                              ItemsSource="{Binding EngineeringGroupModel}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <GroupBox Header="{Binding EngineeringGroupName}" Visibility="{Binding IsAllowedAccess, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <WrapPanel Orientation="Vertical">
                                <ItemsControl ItemsSource="{Binding EngineeringGroupToggleList}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Vertical"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="300"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Style="{StaticResource KeyTextBlockStyle}"
                                                           Text="{Binding EngineeringGroupToggleName}"/>

                                                <Button Grid.Column="1" Background="Red"
                                                        Command="{Binding offEngineeringGroupToggleCommand}"
                                                        CommandParameter="{Binding}"
                                                        IsHitTestVisible="{Binding EngineeringGroupToggleValue}"
                                                        Opacity="{Binding EngineeringGroupToggleValue, Converter={StaticResource InverseOpacityBooleanConverter}}"
                                                                >
                                                    <!--IsEnabled="{Binding EngineeringGroupToggleValue, Converter={StaticResource InverseBooleanConverter}}">-->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Image Grid.Column="0" Source="pack://application:,,,/HMI_SSDC_PIM;component/Icon/LightBulbOff.png"
                                                               Width="35" Height="35"/>
                                                        <TextBlock Grid.Column="1" Style="{StaticResource ValueTextBlockStyle}" Text="Off"/>
                                                    </Grid>
                                                </Button>
                                                <Button Grid.Column="2" Background="LimeGreen"
                                                        Command="{Binding onEngineeringGroupToggleCommand}"
                                                        CommandParameter="{Binding}"
                                                                IsHitTestVisible="{Binding EngineeringGroupToggleValue, Converter={StaticResource InverseBooleanConverter}}"
                                                        Opacity="{Binding EngineeringGroupToggleValue, Converter={StaticResource OpacityBooleanConverter}}">
                                                    <!--IsEnabled="{Binding EngineeringGroupToggleValue}">-->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Image Grid.Column="0" 
                                                               Source="pack://application:,,,/HMI_SSDC_PIM;component/Icon/LightBulbOn.png"
                                                               Width="35" Height="35"/>

                                                        <TextBlock Grid.Column="1" Style="{StaticResource ValueTextBlockStyle}" Text="On"/>
                                                    </Grid>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding EngineeringGroupNumericList}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Vertical"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="300"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Column="0" Grid.Row="0" Style="{StaticResource KeyTextBlockStyle}"
                                                               Text="{Binding EngineeringGroupNumericName}"/>

                                                <mahApps:NumericUpDown Grid.Column="1" Grid.Row="0" Tag="{Binding}"
                                                                           x:Name="EngineeringGroupNumericUpDown"
                                                                           Value="{Binding EngineeringGroupNumericValue}"/>
                                                <Button Grid.Column="2" Grid.Row="0"
                                                            Command="{Binding SetEngineeringGroupNumericCommand}"
                                                            CommandParameter="{Binding ElementName=EngineeringGroupNumericUpDown}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Image Grid.Column="0"
                                                                   Source="pack://application:,,,/HMI_SSDC_PIM;component/Icon/Flash.png"/>

                                                        <TextBlock Grid.Column="1" Text="{DynamicResource Set}"
                                                                       Style="{StaticResource ValueTextBlockStyle}"/>
                                                    </Grid>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding EngineeringGroupTextList}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Vertical"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="300"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Column="0" Grid.Row="0" Style="{StaticResource KeyTextBlockStyle}"
                                                               Text="{Binding EngineeringGroupTextName}"/>

                                                <TextBox Grid.Column="1" x:Name="SettingsGeneralGroupTextBox"
                                                         Tag="{Binding}" Text="{Binding EngineeringGroupTextValue}"/>

                                                <Button Grid.Column="2" Grid.Row="0"
                                                            Command="{Binding sendEngineeringGroupTextCommand}"
                                                            CommandParameter="{Binding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Image Grid.Column="0"
                                                                   Source="pack://application:,,,/HMI_SSDC_PIM;component/Icon/Flash.png"/>

                                                        <TextBlock Grid.Column="1" Text="{DynamicResource Set}"
                                                                       Style="{StaticResource ValueTextBlockStyle}"/>
                                                    </Grid>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding EngineeringGroupReadOnlyList}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Vertical"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="300"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Grid.Row="0" Style="{StaticResource KeyTextBlockStyle}"
                                                               Text="{Binding EngineeringGroupReadOnlyName}"/>

                                                <TextBlock Grid.Column="1" Grid.Row="0" Style="{StaticResource ValueTextBlockStyle}"
                                                               Text="{Binding EngineeringGroupReadOnlyValue}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>
                        </GroupBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    <!--</Grid>-->
</UserControl>
