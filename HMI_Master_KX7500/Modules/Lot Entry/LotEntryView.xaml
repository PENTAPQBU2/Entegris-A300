        </Button>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="TSO Column" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <UniformGrid Rows="1" Grid.Row="7" Grid.Column="1">
            <TextBlock Text="{DynamicResource Off}" Style="{StaticResource RightTextBlock}"/>
            <mahApps:ToggleSwitch x:Name="GeneralToggleSwitch" IsChecked="{Binding TSOColumnValue}" CheckChangedCommand="{Binding TSOColumnCommand}" CheckChangedCommandParameter="{Binding }" VerticalAlignment="Center"/>
            <TextBlock Text="{DynamicResource On}" Style="{StaticResource LeftTextBlock}"/>
        </UniformGrid>
    </Grid>
</UserControl>
