<Window x:Class="HMI_Master_KX7500.Modules.Language.LanguageEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HMI_Master_KX7500.Modules.Language"
        xmlns:cmd="http://www.galasoft.ch/mvvmlight"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        x:Name="LanguageEditorWindow" Height="800"
        ResizeMode="NoResize" TextElement.FontSize="16"
        TextElement.FontWeight="Regular" TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto" Title="{DynamicResource LanguageEditor}"
        Topmost="True" Width="1000" WindowStartupLocation="CenterScreen">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <cmd:EventToCommand Command="{Binding LanguageEditorViewClosingCommand}"
                                EventArgsConverter="{StaticResource EventArgsConverter}"
                                EventArgsConverterParameter="{Binding ElementName=LanguageEditorWindow}"
                                PassEventArgsToCommand="True" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Row="0" Grid.Column="0">
            <GroupBox.Header>
                <Grid Height="{DynamicResource DefaultHeaderHeight}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="pack://application:,,,/HMI_Master_KX7500;component/Icon/Redesign.png" />
                    <TextBlock Grid.Column="1" Style="{StaticResource MaterialDesignHeadlineTextBlock}"
                               Text="{DynamicResource DefaultLanguage}" />
                </Grid>
            </GroupBox.Header>

            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Language}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Content="{Binding LanguageName}" GroupName="LanguageName"
                                         IsChecked="{Binding DefaultLanguage}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>

        <GroupBox Grid.Row="0" Grid.Column="1">
            <GroupBox.Header>
                <Grid Height="25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="pack://application:,,,/HMI_Master_KX7500;component/Icon/Pencil.png" />
                    <TextBlock Grid.Column="1" Style="{StaticResource MaterialDesignHeadlineTextBlock}"
                               Text="{DynamicResource Edit}" />
                </Grid>
            </GroupBox.Header>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Row="0" Grid.Column="0" Source="pack://application:,,,/HMI_Master_KX7500;component/Icon/Redesign.png" />
                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource KeyTextBlockStyle}"
                           Text="{DynamicResource Language}" />
                <ComboBox Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" x:Name="LanguageComboBox"
                          DisplayMemberPath="LanguageName" IsEditable="True" ItemsSource="{Binding Language}" />

                <Button Grid.Row="1" Grid.Column="2" Command="{Binding AddLanguageCommand}"
                        CommandParameter="{Binding ElementName=LanguageComboBox}"
                        IsEnabled="{Binding ElementName=LanguageComboBox, Path=Text, Converter={StaticResource StringToBooleanConverter}}"
                        Width="100" Height="50">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0" Source="pack://application:,,,/HMI_Master_KX7500;component/Icon/Add.png" />
                        <TextBlock Grid.Column="1" Style="{StaticResource ValueTextBlockStyle}"
                                   Text="{DynamicResource Add}" />
                    </Grid>
                </Button>

                <Button Grid.Row="1" Grid.Column="3" Command="{Binding DeleteLanguageCommand}"
                        CommandParameter="{Binding ElementName=LanguageComboBox, Path=SelectedItem}"
                        IsEnabled="{Binding ElementName=LanguageComboBox, Path=SelectedItem, Converter={StaticResource NullToBooleanConverter}}"
                        Width="100" Height="50">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0" Source="pack://application:,,,/HMI_Master_KX7500;component/Icon/TrashCan.png" />
                        <TextBlock Grid.Column="1" Style="{StaticResource ValueTextBlockStyle}"
                                   Text="{DynamicResource Delete}" />
                    </Grid>
                </Button>
            </Grid>
        </GroupBox>

        <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Command="{Binding SaveLanguageCommand}"
                CommandParameter="{Binding ElementName=LanguageEditorWindow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="pack://application:,,,/HMI_Master_KX7500;component/Icon/Diskette.png" Height="35" />
                <TextBlock Grid.Column="1" Style="{StaticResource ValueTextBlockStyle}"
                           Text="{DynamicResource Save}" />
            </Grid>
        </Button>
    </Grid>
</Window>