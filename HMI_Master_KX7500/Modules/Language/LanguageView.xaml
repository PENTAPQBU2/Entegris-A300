<UserControl x:Class="HMI_Master_KX7500.LanguageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HMI_Master_KX7500"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <materialDesign:PopupBox>
        <materialDesign:PopupBox.ToggleContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Image Grid.Row="0" Source="pack://application:,,,/HMI_Master_KX7500;component/Icon/Redesign.png" />
                <TextBlock Grid.Row="1" Style="{StaticResource CenterTextBlock}"
                           Text="{Binding SelectedLanguage.LanguageName}" />
            </Grid>
        </materialDesign:PopupBox.ToggleContent>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Image Grid.Row="0" Source="pack://application:,,,/HMI_Master_KX7500;component/Icon/Redesign.png" />

            <TextBlock Grid.Row="1" Style="{StaticResource CenterTextBlock}"
                       Text="{DynamicResource Language}" />

            <ComboBox Grid.Row="2" Style="{StaticResource ComboBoxStyle}"
                      DisplayMemberPath="LanguageName" ItemsSource="{Binding Language}"
                      SelectedItem="{Binding SelectedLanguage}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding LanguageSelectionChangedCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ComboBox>

            <Button Grid.Row="3" Style="{StaticResource FlatButtonBaseStyle}"
                    Command="{Binding EditLanguageCommand}"
                    Visibility="{Binding AllowEditLanguage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="pack://application:,,,/HMI_Master_KX7500;component/Icon/Pencil.png" />
                    <TextBlock Grid.Column="1" Style="{StaticResource ValueTextBlockStyle}"
                               Text="{DynamicResource EditLanguage}" />
                </Grid>
            </Button>

            <Button Grid.Row="4" Style="{StaticResource FlatButtonBaseStyle}"
                    Command="{Binding EditTranslationCommand}"
                    Visibility="{Binding AllowEditTranslation,Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="pack://application:,,,/HMI_Master_KX7500;component/Icon/Pencil.png" />
                    <TextBlock Grid.Column="1" Style="{StaticResource ValueTextBlockStyle}"
                               Text="{DynamicResource EditTranslation}" />
                </Grid>
            </Button>
        </Grid>
    </materialDesign:PopupBox>
</UserControl>