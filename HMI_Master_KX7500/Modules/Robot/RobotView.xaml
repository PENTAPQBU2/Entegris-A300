<UserControl x:Class="HMI_Master_KX7500.Modules.Robot.RobotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4 3"/>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4 3"/>
        </Style>
        <Style x:Key="AxisValue" TargetType="TextBlock" BasedOn="{StaticResource ValueText}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Robot status and control -->
        <GroupBox Grid.Column="0" Header="Robot" Margin="4" MinWidth="380">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Robot IP" Style="{StaticResource KeyText}"/>
                    <TextBox Grid.Column="1" Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" Margin="4" FontSize="16"/>
                </Grid>
                <WrapPanel>
                    <Button Content="Connect" Command="{Binding ConnectCommand}" Margin="4" Height="40" MinWidth="90"/>
                    <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Margin="4" Height="40" MinWidth="90"/>
                </WrapPanel>

                <Grid Margin="0 8 0 8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Connection" Style="{StaticResource KeyText}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ConnectionText}" Style="{StaticResource ValueText}"/>
                    <TextBlock Grid.Row="1" Text="Robot mode" Style="{StaticResource KeyText}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RobotModeText}" Style="{StaticResource ValueText}"/>
                    <TextBlock Grid.Row="2" Text="Safety" Style="{StaticResource KeyText}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SafetyText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ValueText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProtectiveStop}" Value="True">
                                        <Setter Property="Foreground" Value="Red"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Row="3" Text="Program" Style="{StaticResource KeyText}"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProgramText}" Style="{StaticResource ValueText}"/>
                    <TextBlock Grid.Row="4" Text="Current point" Style="{StaticResource KeyText}"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CurrentPointText}" Style="{StaticResource ValueText}"/>
                    <TextBlock Grid.Row="5" Text="Speed" Style="{StaticResource KeyText}"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ActualSpeedText}" Style="{StaticResource ValueText}"/>
                    <TextBlock Grid.Row="6" Text="Recipe on robot" Style="{StaticResource KeyText}"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding RobotRecipeText}" Style="{StaticResource ValueText}"/>
                    <TextBlock Grid.Row="7" Text="Teach mode" Style="{StaticResource KeyText}"/>
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding TeachModeText}" Style="{StaticResource ValueText}"/>
                </Grid>

                <WrapPanel>
                    <Button Content="Start (power on)" Command="{Binding PowerOnCommand}" Margin="4" Height="40" MinWidth="90"/>
                    <Button Content="Run" Command="{Binding RunCommand}" Margin="4" Height="40" MinWidth="90"/>
                    <Button Content="Pause" Command="{Binding PauseCommand}" Margin="4" Height="40" MinWidth="90"/>
                    <Button Content="Stop" Command="{Binding StopCommand}" Margin="4" Height="40" MinWidth="90"/>
                    <Button Content="Reset" Command="{Binding ResetCommand}" Margin="4" Height="40" MinWidth="90"/>
                </WrapPanel>

                <TextBlock Text="Speed (%)" Style="{StaticResource KeyText}" Margin="4 10 4 0"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="1" Maximum="100" Value="{Binding SpeedPercent}" TickFrequency="5"
                            IsSnapToTickEnabled="False" VerticalAlignment="Center" Margin="4"/>
                    <TextBlock Grid.Column="1" Text="{Binding SpeedPercent}" Style="{StaticResource ValueText}"/>
                    <Button Grid.Column="2" Content="Set speed" Command="{Binding ApplySpeedCommand}" Margin="4" Height="40" MinWidth="90"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- Position and jog -->
        <GroupBox Grid.Column="1" Header="Position and jog" Margin="4" MinWidth="420">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Tool position (base)" Style="{StaticResource KeyText}"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2" Text="Joints (deg)" Style="{StaticResource KeyText}"/>

                    <TextBlock Grid.Row="1" Text="X (mm)" Style="{StaticResource KeyText}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TcpText[0]}" Style="{StaticResource AxisValue}"/>
                    <TextBlock Grid.Row="2" Text="Y (mm)" Style="{StaticResource KeyText}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TcpText[1]}" Style="{StaticResource AxisValue}"/>
                    <TextBlock Grid.Row="3" Text="Z (mm)" Style="{StaticResource KeyText}"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TcpText[2]}" Style="{StaticResource AxisValue}"/>
                    <TextBlock Grid.Row="4" Text="Rx (deg)" Style="{StaticResource KeyText}"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TcpText[3]}" Style="{StaticResource AxisValue}"/>
                    <TextBlock Grid.Row="5" Text="Ry (deg)" Style="{StaticResource KeyText}"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TcpText[4]}" Style="{StaticResource AxisValue}"/>
                    <TextBlock Grid.Row="6" Text="Rz (deg)" Style="{StaticResource KeyText}"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding TcpText[5]}" Style="{StaticResource AxisValue}"/>

                    <TextBlock Grid.Row="1" Grid.Column="3" Text="J1" Style="{StaticResource KeyText}"/>
                    <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding JointText[0]}" Style="{StaticResource AxisValue}"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="J2" Style="{StaticResource KeyText}"/>
                    <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding JointText[1]}" Style="{StaticResource AxisValue}"/>
                    <TextBlock Grid.Row="3" Grid.Column="3" Text="J3" Style="{StaticResource KeyText}"/>
                    <TextBlock Grid.Row="3" Grid.Column="4" Text="{Binding JointText[2]}" Style="{StaticResource AxisValue}"/>
                    <TextBlock Grid.Row="4" Grid.Column="3" Text="J4" Style="{StaticResource KeyText}"/>
                    <TextBlock Grid.Row="4" Grid.Column="4" Text="{Binding JointText[3]}" Style="{StaticResource AxisValue}"/>
                    <TextBlock Grid.Row="5" Grid.Column="3" Text="J5" Style="{StaticResource KeyText}"/>
                    <TextBlock Grid.Row="5" Grid.Column="4" Text="{Binding JointText[4]}" Style="{StaticResource AxisValue}"/>
                    <TextBlock Grid.Row="6" Grid.Column="3" Text="J6" Style="{StaticResource KeyText}"/>
                    <TextBlock Grid.Row="6" Grid.Column="4" Text="{Binding JointText[5]}" Style="{StaticResource AxisValue}"/>
                </Grid>

                <Button Command="{Binding TeachModeCommand}" Height="40" MinWidth="90" Margin="4 12 4 4">
                    <Button.Content>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Enter teach mode"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TeachRequested}" Value="True">
                                            <Setter Property="Text" Value="Leave teach mode"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button.Content>
                </Button>
                <TextBlock Text="Teach mode is allowed by the PLC only when no lot is running and the machine is not in auto."
                           TextWrapping="Wrap" Style="{StaticResource ValueText}" FontSize="11"/>

                <Grid Margin="0 8 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Jog step" Style="{StaticResource KeyText}"/>
                    <TextBox Grid.Column="1" Text="{Binding JogStepText, UpdateSourceTrigger=PropertyChanged}" Margin="4" FontSize="16"/>
                    <TextBlock Grid.Column="2" Text="mm / deg  (0.01 - 10.00)" Style="{StaticResource ValueText}"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="4">
                    <TextBlock Text="Frame" Style="{StaticResource KeyText}"/>
                    <RadioButton Content="Base" Margin="8 0" VerticalAlignment="Center"
                                 IsChecked="{Binding ToolFrame, Converter={StaticResource InverseBooleanConverter}}"/>
                    <RadioButton Content="Tool" Margin="8 0" VerticalAlignment="Center" IsChecked="{Binding ToolFrame}"/>
                </StackPanel>

                <UniformGrid Columns="4" HorizontalAlignment="Left">
                    <Button Content="X -" Command="{Binding JogCommand}" CommandParameter="0-" Margin="3" Width="70" Height="40" FontSize="16" FontWeight="Bold"/>
                    <Button Content="X +" Command="{Binding JogCommand}" CommandParameter="0+" Margin="3" Width="70" Height="40" FontSize="16" FontWeight="Bold"/>
                    <Button Content="Rx -" Command="{Binding JogCommand}" CommandParameter="3-" Margin="3" Width="70" Height="40" FontSize="16" FontWeight="Bold"/>
                    <Button Content="Rx +" Command="{Binding JogCommand}" CommandParameter="3+" Margin="3" Width="70" Height="40" FontSize="16" FontWeight="Bold"/>
                    <Button Content="Y -" Command="{Binding JogCommand}" CommandParameter="1-" Margin="3" Width="70" Height="40" FontSize="16" FontWeight="Bold"/>
                    <Button Content="Y +" Command="{Binding JogCommand}" CommandParameter="1+" Margin="3" Width="70" Height="40" FontSize="16" FontWeight="Bold"/>
                    <Button Content="Ry -" Command="{Binding JogCommand}" CommandParameter="4-" Margin="3" Width="70" Height="40" FontSize="16" FontWeight="Bold"/>
                    <Button Content="Ry +" Command="{Binding JogCommand}" CommandParameter="4+" Margin="3" Width="70" Height="40" FontSize="16" FontWeight="Bold"/>
                    <Button Content="Z -" Command="{Binding JogCommand}" CommandParameter="2-" Margin="3" Width="70" Height="40" FontSize="16" FontWeight="Bold"/>
                    <Button Content="Z +" Command="{Binding JogCommand}" CommandParameter="2+" Margin="3" Width="70" Height="40" FontSize="16" FontWeight="Bold"/>
                    <Button Content="Rz -" Command="{Binding JogCommand}" CommandParameter="5-" Margin="3" Width="70" Height="40" FontSize="16" FontWeight="Bold"/>
                    <Button Content="Rz +" Command="{Binding JogCommand}" CommandParameter="5+" Margin="3" Width="70" Height="40" FontSize="16" FontWeight="Bold"/>
                </UniformGrid>
            </StackPanel>
        </GroupBox>

        <!-- Recipe points: move to, teach, save -->
        <GroupBox Grid.Column="2" Header="Recipe points" Margin="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Recipe" Style="{StaticResource KeyText}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}"
                              DisplayMemberPath="RecipeName" Margin="4" FontSize="16"/>
                    <TextBlock Grid.Column="2" Text="not saved" Foreground="Red" FontWeight="Bold" Style="{StaticResource ValueText}"
                               Visibility="{Binding RecipeDirty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>

                <ListBox Grid.Row="1" ItemsSource="{Binding Points}" SelectedItem="{Binding SelectedPoint}" Margin="4">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding Display}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ValueText}" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <WrapPanel Grid.Row="2">
                    <Button x:Name="MoveButton" Content="Move to point (hold)" Margin="4" Height="40" MinWidth="170"
                            IsEnabled="{Binding InTeachMode}"
                            PreviewMouseLeftButtonDown="moveButtonDown" PreviewMouseLeftButtonUp="moveButtonUp"
                            LostMouseCapture="moveButtonReleased" MouseLeave="moveButtonReleased"/>
                    <Button Content="Teach point" Command="{Binding TeachPointCommand}" Margin="4" Height="40" MinWidth="90"/>
                    <Button Content="Load recipe to robot" Command="{Binding LoadRecipeToRobotCommand}" Margin="4" Height="40" MinWidth="170"/>
                    <Button Content="Save" Command="{Binding SaveRecipeCommand}" Margin="4" Height="40" MinWidth="90"/>
                </WrapPanel>
                <TextBlock Grid.Row="3" TextWrapping="Wrap" Style="{StaticResource ValueText}" FontSize="11"
                           Text="Move to point: the robot moves while the button is held and stops when it is released. Screw points are approached by lifting 25 mm, then the entry point, then down."/>
            </Grid>
        </GroupBox>

        <Border Grid.Row="1" Grid.ColumnSpan="3" BorderThickness="1" BorderBrush="Gray" Margin="4" Padding="6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="OFFLINE - simulated robot" Foreground="DarkOrange" FontWeight="Bold"
                           Visibility="{Binding IsOffline, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Text="{Binding Message}" FontSize="14"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
