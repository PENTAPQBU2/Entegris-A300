<Window x:Class="HMI_Master_KX7500.Modules.Frame.ConfirmView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="700" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen" WindowStyle="ToolWindow" Background="White"
        TextElement.FontSize="{DynamicResource DefaultFontSize}">

    <!-- Confirm pop-up for Hard Reset (MT_006) and Initialize (MT_005), same size as the PLC pop-up -->
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TextBlockMessage" Grid.Row="0" FontSize="30" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" Margin="0 10 0 30"/>

        <UniformGrid Grid.Row="1" Rows="1" HorizontalAlignment="Center">
            <Button x:Name="ButtonYes" Click="ButtonYes_Click" FontSize="20" Height="60" MinWidth="200" Margin="10 0"/>
            <Button x:Name="ButtonNo" Click="ButtonNo_Click" FontSize="20" Height="60" MinWidth="200" Margin="10 0" IsCancel="True"/>
        </UniformGrid>
    </Grid>
</Window>
