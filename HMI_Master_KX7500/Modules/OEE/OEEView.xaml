<UserControl x:Class="HMI_Master_KX7500.OEEView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HMI_Master_KX7500"
             xmlns:cmd="http://www.galasoft.ch/mvvmlight"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:liveCharts="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf">

    <UserControl.Resources>
        <Style x:Key="ValueTextBlockStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Padding" Value="4 2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.23" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KeyTextBlockStyle" TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource ValueTextBlockStyle}">
            <Setter Property="FontWeight" Value="Black" />
        </Style>

        <Style x:Key="TitleTextBlockStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ValueTextBlockStyle}">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="20" />
        </Style>
    </UserControl.Resources>

    <GroupBox DataContext="{Binding OEEInterfaceModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="{DynamicResource HourlyUph}">
                <liveCharts:CartesianChart x:Name="OEEHourlyUphCartesianChart" DataTooltip="{x:Null}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseMove">
                            <cmd:EventToCommand Command="{Binding OEEHourlyUphCartesianChartMouseMoveCommand}"
                                                EventArgsConverter="{StaticResource EventArgsConverter}"
                                                EventArgsConverterParameter="{Binding ElementName=OEEHourlyUphCartesianChart}"
                                                PassEventArgsToCommand="True" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>

                    <liveCharts:CartesianChart.AxisX>
                        <liveCharts:Axis Labels="{Binding OEEHourlyUphLabels}" Title="{DynamicResource Time}">
                            <liveCharts:Axis.Sections>
                                <liveCharts:AxisSection DataLabel="True" DataLabelForeground="White"
                                                        DisableAnimations="True" SectionOffset="-0.5"
                                                        Fill="#59FF5722"
                                                        SectionWidth="1" Stroke="#FFFF5722"
                                                        StrokeThickness=".5" Value="{Binding OEEHourlyUphXPointer}" />
                            </liveCharts:Axis.Sections>
                            <liveCharts:Axis.Separator>
                                <liveCharts:Separator Step="1" />
                            </liveCharts:Axis.Separator>
                        </liveCharts:Axis>
                    </liveCharts:CartesianChart.AxisX>

                    <liveCharts:CartesianChart.AxisY>
                        <liveCharts:Axis LabelFormatter="{Binding OEEHourlyUphLabelFormatter}"
                                         Title="{DynamicResource Uph}">
                            <liveCharts:Axis.Sections>
                                <liveCharts:AxisSection DataLabel="True" DataLabelForeground="White"
                                                        DisableAnimations="True" Panel.ZIndex="1"
                                                        Stroke="#FFFF5722"
                                                        StrokeThickness="1" Value="{Binding OEEHourlyUphYPointer}" />
                            </liveCharts:Axis.Sections>
                        </liveCharts:Axis>
                    </liveCharts:CartesianChart.AxisY>

                    <liveCharts:CartesianChart.Series>
                        <liveCharts:ColumnSeries Values="{Binding OEEHourlyUphValues}" />
                    </liveCharts:CartesianChart.Series>
                </liveCharts:CartesianChart>
            </GroupBox>

            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding OEEModel.OEEDataList}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <GroupBox Header="{Binding OEEDataName}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ItemsControl Grid.Row="0" Grid.Column="0"
                                                  ItemsSource="{Binding OEEReadOnlyList}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" MinWidth="140" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding OEEReadOnlyName}"
                                                               Style="{StaticResource KeyTextBlockStyle}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding OEEReadOnly}"
                                                               Style="{StaticResource ValueTextBlockStyle}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl Grid.Row="1" Grid.Column="0" ItemsSource="{Binding OEETimeList}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" MinWidth="140" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding OEETimeName}"
                                                               Style="{StaticResource KeyTextBlockStyle}" />
                                                    <TextBlock Grid.Column="1"
                                                               Style="{StaticResource ValueTextBlockStyle}"
                                                               Text="{Binding OEETime, Converter={StaticResource SecondsToTimeConverter}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                                  ItemsSource="{Binding OEECountList}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="7" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <GroupBox Header="{Binding OEECountName}">
                                                    <liveCharts:Gauge From="{Binding OEEMinimumCount}"
                                                                      To="{Binding OEEMaximumCount}"
                                                                      Value="{Binding OEECount}"
                                                                      HighFontSize="20" />
                                                </GroupBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </GroupBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </GroupBox>
</UserControl>