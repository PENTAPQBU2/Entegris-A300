<Application x:Class="HMI_Master_KX7500.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:mahApps="http://metro.mahapps.com/winfx/xaml/controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d1p1="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HMI_Master_KX7500" StartupUri="/Modules/Frame/FrameView.xaml"
        DispatcherUnhandledException="Application_DispatcherUnhandledException" d1p1:Ignorable="d">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HMI;component/Themes/MaterialDesign.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Pentamaster;component/HMI/Themes/HMI.xaml" />
                <ResourceDictionary Source="pack://application:,,,/PQ.HMI;component/Themes/Defaults.xaml" />
                <ResourceDictionary x:Name="ChineseSimplified" Source="pack://application:,,,/HMI_SSDC_PIM;component/Languages/ChineseSimplified.xaml" />
                <ResourceDictionary x:Name="English" Source="pack://application:,,,/HMI_SSDC_PIM;component/Languages/English.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="{x:Type mahApps:NumericUpDown}">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Margin" Value="2" />
                <Setter Property="Minimum" Value="-1000000" />
                <Setter Property="MinWidth" Value="100" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <local:EventArgsConverter x:Key="EventArgsConverter" />
            <local:SecondsToTimeConverter x:Key="SecondsToTimeConverter" />
            <local:SecondsToDaysConverter x:Key="SecondsToDaysConverter" />
            <local:SecondsToHoursConverter x:Key="SecondsToHoursConverter" />
            <local:SecondsToMinutesConverter x:Key="SecondsToMinutesConverter" />
            <local:SecondsToSecondsConverter x:Key="SecondsToSecondsConverter" />
            <!--<local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanConverter" />-->
            <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <local:InverseOpacityBooleanConverter x:Key="InverseOpacityBooleanConverter" />
            <local:OpacityBooleanConverter x:Key="OpacityBooleanConverter" />
            <local:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <local:NullToBooleanConverter x:Key="NullToBooleanConverter" />
            <local:StringToBooleanConverter x:Key="StringToBooleanConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>